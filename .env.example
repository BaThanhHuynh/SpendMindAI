# ==============================================================================
# SPENDMINDAI - ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (HỖ TRỢ CẢ LOCAL, DOCKER & CLOUD VERCEL)
# ------------------------------------------------------------------------------
# Cách 1: Sử dụng chuỗi kết nối chuẩn (tiện lợi khi dùng Cloud DB như TiDB Serverless, Railway, Aiven):
# DATABASE_URL=mysql://username:password@gateway01.prod.aws.tidbcloud.com:4000/spendmind?ssl-mode=REQUIRED

# Cách 2: Cấu hình từng thông số riêng lẻ:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password
DB_NAME=quan_ly_chi_tieu

# Bật kết nối bảo mật SSL (mặc định tự động bật cho Cloud DB từ xa như TiDB):
DB_SSL=false

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Lấy API Key miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. GOOGLE SIGN-IN OAUTH CLIENT ID (TÙY CHỌN)
# ------------------------------------------------------------------------------
# Tạo Client ID tại Google Cloud Console (APIs & Services -> Credentials)
# Nếu để trống, hệ thống sẽ chuyển sang chế độ mô phỏng đăng nhập tài khoản demo.
GOOGLE_CLIENT_ID=125274610515-6qi1cnl41k7itnfch3v6123q6tbqgovf.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. SMTP EMAIL REMINDERS (TÙY CHỌN)
# ------------------------------------------------------------------------------
# Đặt false nếu chưa muốn kích hoạt gửi mail thật (hệ thống sẽ mô phỏng)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME="SpendMindAI"

# ------------------------------------------------------------------------------
# 5. VERCEL CRON & SYSTEM CRON SECURITY TOKEN
# ------------------------------------------------------------------------------
# Mã bí mật để kích hoạt cron job gửi mail nhắc nhở tự động
CRON_TOKEN=safe_cron_token_2026
# Khi deploy trên Vercel, đặt trùng với CRON_SECRET trên Vercel Project Settings:
CRON_SECRET=

# ------------------------------------------------------------------------------
# 6. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
APP_ENV=production
# URL chính thức của ứng dụng (ví dụ: https://spendmindai.vercel.app hoặc https://yourdomain.com)
APP_URL=
# Danh sách CORS Whitelist nếu có frontend khác gọi vào:
ALLOWED_ORIGINS=
